# Copy this file to backend/.env for local development:  cp .env.example backend/.env
# Then fill in the values. NEVER commit the real .env file (it is in .gitignore).
# On Render, add the same names under Environment instead of using a file.

# --- Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Supabase (Project Settings -> API) ---
SUPABASE_URL=
# The secret "service_role" key. Backend only. Never put it in the frontend.
SUPABASE_SERVICE_KEY=

# --- Optional protection for your own endpoints ---
GATEWAY_API_KEY=
ADMIN_API_KEY=

# Your Vercel URL once deployed (comma separated). "*" is fine for local testing.
ALLOWED_ORIGINS=*
